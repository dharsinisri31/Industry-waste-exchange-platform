# ===================================================
# EcoLink Platform - Environment Variables Template
# ===================================================
# Copy this file or individual subservice .env.example files 
# to their respective .env files before starting services.

# --- Backend Server (server/.env) ---
# PORT=5000
# MONGO_URI=mongodb://127.0.0.1:27017/waste_exchange
# JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
# JWT_REFRESH_SECRET=your_jwt_refresh_token_key_here
# ADMIN_REGISTRATION_SECRET=admin_secret_key_ideathon_2026
# NODE_ENV=development

# --- Frontend Client (client/.env) ---
# VITE_API_BASE_URL=http://localhost:5000/api

# --- AI Microservice (ai-service/.env) ---
# HOST=127.0.0.1
# PORT=8000
# ENVIRONMENT=development
# MODEL_NAME=best_waste_detector.pt
# EMBEDDING_MODEL=all-MiniLM-L6-v2
